# Configuración de main.py

# --- Cámara y YOLO ---------------------------------------------------------
CAMERA=0                    # índice de la cámara (0 = la integrada)
YOLO_MODEL=yolo26n.pt       # yolo26n / s / m / l / x (más grande = más preciso y más lento)
YOLO_CONF=0.45              # confianza mínima de una detección (0-1)
YOLO_DEVICE=                # vacío = automático (mps en Mac Apple Silicon) · cpu · 0 (CUDA)
STABLE_FRAMES=8             # frames que la escena debe mantenerse para anunciarla
ANNOUNCE_COOLDOWN=3.0       # segundos mínimos entre anuncios automáticos
POSE=true                   # detecta manos levantadas (segundo modelo YOLO de pose)
POSE_MODEL=yolo26n-pose.pt  # yolo26n-pose / s / m… (descarga automática)
POSE_KP_CONF=0.3            # confianza mínima de cada punto (hombro, codo, muñeca)
POSE_DEBUG=false           # true = imprime los puntos de cada brazo en la terminal

# --- Cara y dedos (MediaPipe; los modelos se descargan solos en models/) -----
FACE=true                   # cabeza, ojos cerrados, pestañeos, guiños
FACE_EXPRESSIONS=true       # además: sonrisa y boca abierta
FINGERS=true                # qué dedos mostrás (pulgar, índice, medio, anular, meñique)
HEAD_TURN_DEG=20            # grados para "giraste la cabeza"
HEAD_TILT_DEG=15            # grados para "miraste arriba/abajo" e "inclinaste la cabeza"
EYES_CLOSED_SECONDS=1.0     # ojos cerrados más que esto = "cerraste los ojos" (menos = pestañeo)
DOUBLE_BLINK=decir          # doble pestañeo: decir | describir (como apretar d) | nada

# --- Voz ---------------------------------------------------------------------
VOICE=Paulina               # macOS: Paulina (MX), Mónica (ES)… ver: say -v '?'

# --- LLM local ----------------------------------------------------------------
# Vacío LOCAL_LLM_BASE_URL = sin LLM, solo YOLO + voz.
LOCAL_LLM_BASE_URL=https://macos.tailcc45b1.ts.net/v1
LOCAL_LLM_API_KEY=sk-mi-clave-secreta-123
LOCAL_LLM_MODEL=qwen3-vl-2b-it

LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120             # segundos
LLM_HISTORY_TURNS=6         # preguntas/respuestas que recuerda (0 = sin memoria)
IMAGE_MAX_SIDE=1024         # px; más chico = más rápido y menos tokens
